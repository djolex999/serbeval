        "gen_prefix": null,
        "fewshot_delimiter": "\n\n",
        "target_delimiter": " "
      },
      "num_fewshot": 0,
      "metric_list": [
        {
          "metric": "exact_match",
          "aggregation": "mean",
          "higher_is_better": true
        },
        {
          "metric": "unparsed",
          "aggregation": "mean",
          "higher_is_better": false
        },
        {
          "metric": "pair_agreement",
          "aggregation": "def pair_agreement(items: Sequence[tuple[str, float]]) -> float:\n    \"\"\"Fraction of pairs whose two scripts produced the SAME correctness outcome.\n\n    A pair \"agrees\" when the model is right on both scripts or wrong on both — i.e. the\n    answer is script-invariant. Mixed outcomes count as disagreement.\n    \"\"\"\n    by_pair: dict[str, list[float]] = {}\n    for pair_id, correct in items:\n        by_pair.setdefault(pair_id, []).append(correct)\n    complete = [vals for vals in by_pair.values() if len(vals) == 2]\n    if not complete:\n        return 0.0\n    agreed = sum(1 for vals in complete if vals[0] == vals[1])\n    return agreed / len(complete)\n",
          "higher_is_better": true
        }
      ],
