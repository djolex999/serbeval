        }
      },
      "test_split": "test",
      "doc_to_text": "def doc_to_text(doc: dict) -> str:\n    lines = [doc[\"question\"], \"\"]\n    for letter, choice in zip(LETTERS, doc[\"choices\"], strict=False):\n        lines.append(f\"{letter}) {choice}\")\n    lines.append(\"\")\n    lines.append(\"Odgovori samo slovom tačnog odgovora (A, B, C ili D).\")\n    lines.append(\"Odgovor:\")\n    return \"\\n\".join(lines)\n",
      "doc_to_target": "def doc_to_target(doc: dict) -> str:\n    return LETTERS[doc[\"answer_index\"]]\n",
      "unsafe_code": false,
      "process_results": "def process_results_pair(doc: dict, results: list[str]) -> dict:\n    \"\"\"Emit accuracy, an unparsed flag, and a (pair_id, correct) tuple for aggregation.\"\"\"\n    correct = _extracted_correct(doc, results)\n    return {\n        \"exact_match\": correct,\n        \"unparsed\": _unparsed(results),\n        \"pair_agreement\": (doc[\"pair_id\"], correct),\n    }\n",
      "description": "",
      "target_delimiter": " ",
      "fewshot_delimiter": "\n\n",
      "fewshot_config": {
        "sampler": "default",
        "split": null,
        "process_docs": null,
        "fewshot_indices": null,
        "samples": null,
        "doc_to_text": "<function doc_to_text at 0x12de5ae80>",
        "doc_to_choice": null,
